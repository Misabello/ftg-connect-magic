# Backend gestionado por Lovable Cloud. Estas variables se generan automáticamente
# y se incluyen sólo como referencia para entornos externos.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Sólo servidor (nunca exponer en el frontend)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Etapa 4 — proveedor de generación de imágenes (interfaz desacoplada)
IMAGE_PROVIDER=lovable-ai